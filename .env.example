-- 2de-store — placeholder configuration.
-- Copy to `.env` and fill in. NEVER commit the real `.env`.
-- Every value below marked CHANGEME is unknown until the business is registered.
-- Do NOT invent values for payment gateways, couriers or bank details.

# ---------------------------------------------------------------------------
# BRAND
# Public: safe to expose to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="2DE BARGAINS"
NEXT_PUBLIC_BRAND_URL="http://localhost:3000"
NEXT_PUBLIC_TAGLINE="Tested bargains. Better prices."
NEXT_PUBLIC_CURRENCY="ZAR"

# ---------------------------------------------------------------------------
# DATABASE
# SQLite by default (zero setup). To move to PostgreSQL, change the `provider`
# in prisma/schema.prisma to "postgresql" and use a postgres:// URL.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# STORAGE — where the files the store writes at runtime live.
# src/lib/data-paths.ts
#
# Both default to a directory under the app root, which is correct on any host
# with a persistent disk. On a host that rebuilds the container on every deploy
# (Railway), point them at the attached volume or the photos and the intake
# originals disappear on the first redeploy:
#
#   DATABASE_URL="file:/data/dev.db"   (at the mount root — Prisma creates the
#                                       file but not its parent directory)
#   UPLOADS_DIR="/data/uploads"       -> /data/uploads/products, /data/uploads/ai
#   DATA_DIR="/data/private"          -> /data/private/intake, /data/private/masks-clean
#
# Public URLs do not change: images are still served from /uploads/....
# ---------------------------------------------------------------------------
# UPLOADS_DIR=""
# DATA_DIR=""

# ---------------------------------------------------------------------------
# SECRETS — generate with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
# Signs the admin session cookie. Rotating it logs all admins out.
AUTH_SECRET="CHANGEME-generate-a-long-random-string"
# Signs/encrypts the customer cart cookie.
CART_SECRET="CHANGEME-generate-a-different-long-random-string"
# Optional: required only for multi-instance / self-hosted Server Actions.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="CHANGEME"

# ---------------------------------------------------------------------------
# ADMIN BOOTSTRAP (used once by `npm run db:seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGEME-change-me"
ADMIN_NAME="Store Owner"

# ---------------------------------------------------------------------------
# CONTACT / WHATSAPP
# Include the country code, no +, no spaces. e.g. 27821234567
#
# LEAVE THESE BLANK until the business has a real number and mailbox. The site
# hides any channel that is blank, so a placeholder value would be published as
# if it were real — and a placeholder phone number belongs to a stranger.
# With all three blank the site simply says contact details are not published
# yet, and points people at their order page instead.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
# Unconfirmed. Leave blank to hide opening hours on the site entirely.
NEXT_PUBLIC_CONTACT_HOURS=""

# ---- Legal / company identity -------------------------------------------
# UNCONFIRMED PLACEHOLDERS. The privacy, terms, returns and about pages show a
# visible warning until these are filled in and reviewed by someone qualified.
# Do not invent these values; get them from the business owner.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=""
NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER=""
NEXT_PUBLIC_LEGAL_VAT_NUMBER=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_CITY=""
NEXT_PUBLIC_LEGAL_PROVINCE="Gauteng"
NEXT_PUBLIC_LEGAL_POSTAL_CODE=""
NEXT_PUBLIC_LEGAL_CONTACT_PERSON=""

# ---------------------------------------------------------------------------
# PAYMENT PROVIDER  (modular — nothing is hard-coded)
# Providers live in src/lib/payments/providers/
#   "offline"  = no gateway yet. The order is created UNPAID, the item is held,
#                and you record payment by hand in the admin. This is honest:
#                the site never claims a payment succeeded that did not.
#   "none"     = fully disabled, checkout is closed.
# "payfast" and "yoco" are implemented (src/lib/payments/providers/). Each stays
# inactive until ALL of its credentials below are filled in for one environment;
# until then the store keeps using "offline" rather than sending a customer to
# a gateway that will reject them.
# Credentials are NOT shipped with this repo and must be added by you.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="offline"
# PayFast: ID = merchant_id, PASS = merchant_key, PASSPHRASE = the security
# passphrase set in your PayFast account. Sandbox values win when present.
# PAYFAST_SANDBOX_ID=""
# PAYFAST_SANDBOX_PASS=""
# PAYFAST_LIVE_ID=""
# PAYFAST_LIVE_PASS=""
# PAYFAST_PASSPHRASE=""
# IKHOKHA_APP_ID=""
# IKHOKHA_APP_SECRET=""
# IKHOKHA_SANDBOX_KEY=""
# IKHOKHA_LIVE_KEY=""

# ---------------------------------------------------------------------------
# YOCO  (Checkout API — redirect to a hosted Yoco page, settle by webhook)
#
# Get both values from the Yoco App > Yoco Connect > Checkout API > How to
# connect (https://app.yoco.com/manage/yoco-connect/integration?name=checkout_api).
#
#   YOCO_SECRET_KEY       "Test secret key" first. Copying the "Live secret key"
#                         (sk_live_...) is what starts charging real cards — do
#                         that only after one test checkout has settled.
#   YOCO_WEBHOOK_SECRET   Shown ONCE, when you register the webhook. If it is
#                         missing, checkout stays closed rather than accepting
#                         payments the store cannot verify.
#
# Register the webhook once, save the secret it returns, then set:
#
#   curl -X POST https://payments.yoco.com/api/webhooks \
#     -H "Authorization: Bearer $YOCO_SECRET_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"2de-store","url":"https://<your-domain>/api/payments/yoco/notify"}'
#
# Yoco only supports ZAR, and declines payments under R2.00. Test keys work
# without any domain verification; live keys stay locked until the business
# website is added under "Verified Domains".
# ---------------------------------------------------------------------------
# YOCO_SECRET_KEY=""
# YOCO_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# COURIER / TRACKING  (modular — no API calls are made)
# Providers live in src/lib/courier/providers/
#   "manual" = you type the tracking number in the admin dashboard.
# ---------------------------------------------------------------------------
COURIER_PROVIDER="manual"
# COURIER_API_KEY=""
# COURIER_ACCOUNT_ID=""

# ---------------------------------------------------------------------------
# TRANSACTIONAL EMAIL
# The store tells the customer when their item is secured, shipped and
# delivered. That is the whole business model, so this is not optional in
# practice — but nothing is faked when it is unset.
#
#   "log"    = write to the server log, mark the attempt SKIPPED_NOT_CONFIGURED.
#              Safe default, and it tells you honestly that no email went out.
#   "resend" = real delivery via Resend. Set RESEND_API_KEY and
#              MAIL_FROM_ADDRESS (plus MAIL_FROM_NAME for the sender label).
#
# Every attempt is recorded in the EmailLog table either way, so the admin order
# page always shows whether a customer actually received the message.
# ---------------------------------------------------------------------------
MAIL_PROVIDER="log"
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="2DE BARGAINS"
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# STORAGE  (product image uploads)
#   "local" = writes to ./public/uploads  (fine for a VPS with a disk)
#   On serverless platforms use an object-storage module instead.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
MAX_UPLOAD_MB="8"

# ---------------------------------------------------------------------------
# AI PHOTO CLEAN-UP  (removing the pawn shop's own price sticker)
# ---------------------------------------------------------------------------
# Optional. With no key set, the admin simply does not show the
# "Remove price tag with AI" button and nothing else changes.
#
# Get a key from https://aistudio.google.com/apikey
#
# This uses Google's Gemini image editing model, which reconstructs the surface
# underneath a removed object. It is deliberately NOT a blur, a crop or a
# painted patch, because those destroy the pixels they cover and would quietly
# damage the product itself.
#
# Cost is per photo and only when an admin asks for it — the tool never runs
# over the catalogue on its own.
#
# GEMINI_API_KEY=""
#
# Optional overrides. Defaults are sensible; change them only if you have a
# reason to. Available image models: gemini-3.1-flash-image (default, cheapest
# good option), gemini-3-pro-image (highest fidelity, costs about 2x).
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
# Detection only needs to see, not to draw, so this can point at a cheaper
# text/vision model. Defaults to GEMINI_IMAGE_MODEL.
# GEMINI_VISION_MODEL=""

# ---------------------------------------------------------------------------
# STORE DEFAULTS
# ---------------------------------------------------------------------------
# Lockers typically accept parcels up to ~2kg and ~35cm on the longest side.
# Confirm with your courier before going live.
DEFAULT_LOCKER_MAX_WEIGHT_G="2000"
DEFAULT_LOCKER_MAX_DIM_CM="35"

# Manual payment opens production checkout only with actual customer payment instructions.
OFFLINE_PAYMENT_INSTRUCTIONS=""

# Peach Payments provider is prepared but disabled until approval/API verification.
# Confirm the approved Checkout API and credential mapping with Peach first.
PEACH_MODE="sandbox"
PEACH_MERCHANT_ID=""
PEACH_CLIENT_ID=""
PEACH_CLIENT_SECRET=""
PEACH_WEBHOOK_SECRET=""
